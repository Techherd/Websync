{
  "name": "websync-self-hosted",
  "version": "1.0.0",
  "description": "Self-hosted file synchronization between Unraid servers",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "docker:build": "./scripts/docker-build.sh build",
    "docker:build:amd64": "./scripts/docker-build.sh build amd64",
    "docker:build:arm64": "./scripts/docker-build.sh build arm64",
    "docker:push": "./scripts/docker-build.sh push",
    "docker:build:local": "docker build -t websync:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "prisma:migrate": "npm run prisma migrate dev --workspace=backend",
    "prisma:generate": "npm run prisma generate --workspace=backend"
  },
  "keywords": ["sync", "unraid", "docker", "rsync", "backup"],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
