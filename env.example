# WebSync Environment Configuration
# Copy this file to .env and update values

# ==========================================
# Docker Hub Image (for remote deployment)
# ==========================================
DOCKER_HUB_IMAGE=your-dockerhub-username/websync
WEBSYNC_VERSION=latest

# ==========================================
# Authentication (REQUIRED - Change these!)
# ==========================================

# Password for WebSync login
AUTH_PASSWORD=your-secure-password-here

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ==========================================
# Network Configuration
# ==========================================

# Port to expose WebSync on
WEBSYNC_PORT=3000

# ==========================================
# SSH Configuration
# ==========================================

# Path to SSH keys directory on the host
SSH_KEY_PATH=/root/.ssh
